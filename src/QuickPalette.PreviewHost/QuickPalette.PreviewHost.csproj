<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickPalette.PreviewHost</AssemblyName>
    <RootNamespace>QuickPalette.PreviewHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 与主程序共用品牌图标（任务管理器/崩溃对话框显示） -->
    <ApplicationIcon>..\QuickPalette.App\Assets\app.ico</ApplicationIcon>
    <!-- 与主程序同为 x64：进程内预览处理器的 DLL 位数必须与宿主一致；
         32 位处理器经解析器跳过后回落既有预览链路（如需承载可再补 x86 宿主） -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickPalette.Infrastructure\QuickPalette.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- x86 姊妹工程位于子目录：排除其源码/产物，避免默认通配把两套生成的
         程序集特性文件一起编译（CS0579 特性重复） -->
    <Compile Remove="x86\**" />
    <None Remove="x86\**" />
    <EmbeddedResource Remove="x86\**" />
  </ItemGroup>

</Project>
