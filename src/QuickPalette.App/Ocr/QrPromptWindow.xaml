<Window x:Class="QuickPalette.App.Ocr.QrPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">
    <Border Background="#F52B3446"
            CornerRadius="10"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="14">
        <StackPanel Width="360">
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="2,2,2,10">
                <ContentControl x:Name="TitleIconHost" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="二维码"
                           Foreground="#AAB6CC"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 识别到的码（每条一行） -->
            <ItemsControl x:Name="CodeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2EFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Label"
                                               Text="内容"
                                               Foreground="#8899AA"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding Display}"
                                               Foreground="White"
                                               FontSize="13.5"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="打开"
                                            Width="52" Height="30"
                                            Background="#FF4C8DFF"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"
                                            Click="Open_Click"/>
                                    <Button Content="复制"
                                            Width="52" Height="30"
                                            Background="#2EFFFFFF"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="6,0,0,0"
                                            Click="Copy_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 底部：全部复制 + 关闭 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyAllButton" Content="全部复制"
                        Width="80" Height="28"
                        Background="#2EFFFFFF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="CopyAll_Click"/>
                <Button Content="关闭"
                        Width="64" Height="28"
                        Background="Transparent" Foreground="#AAB6CC"
                        BorderThickness="0" Cursor="Hand"
                        Margin="8,0,0,0"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
