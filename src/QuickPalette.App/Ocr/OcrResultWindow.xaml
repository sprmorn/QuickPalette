<Window x:Class="QuickPalette.App.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字识别"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel Width="560">
            <!-- 标题栏 -->
            <Border Background="{DynamicResource BgTitle}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl x:Name="TitleIconHost" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="文字识别结果"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Background="Transparent"
                            Foreground="{DynamicResource CloseButtonBrush}" BorderThickness="0"
                            FontSize="16" Width="28" Height="28" Cursor="Hand" Click="Close_Click"
                            HorizontalAlignment="Right" Padding="0"/>
                </Grid>
            </Border>

            <!-- 识别中 -->
            <TextBlock x:Name="StatusText"
                       Margin="18,14,18,0"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"/>

            <!-- 结果文本（可修正） -->
            <Border Background="{DynamicResource InputBrush}"
                    CornerRadius="8"
                    Margin="16,10,16,0"
                    Height="300">
                <TextBox x:Name="ResultBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         FontSize="14"
                         Padding="10"/>
            </Border>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,18">
                <Button Content="搜索此文本" Style="{StaticResource SecondaryButtonStyle}" Width="108" Click="Search_Click"/>
                <Button Content="复制全部" Style="{StaticResource SecondaryButtonStyle}" Width="92" Margin="10,0,0,0" Click="CopyAll_Click"/>
                <Button Content="复制并关闭" Style="{StaticResource PrimaryButtonStyle}" Width="108" Margin="10,0,0,0" Click="CopyClose_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
