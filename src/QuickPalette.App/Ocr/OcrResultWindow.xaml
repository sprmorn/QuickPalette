<Window x:Class="QuickPalette.App.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字识别"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel Width="620">
            <!-- 标题栏 -->
            <Border Background="{DynamicResource BgTitle}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl x:Name="TitleIconHost" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="文字识别结果"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Background="Transparent"
                            Foreground="{DynamicResource CloseButtonBrush}" BorderThickness="0"
                            FontSize="16" Width="28" Height="28" Cursor="Hand" Click="Close_Click"
                            HorizontalAlignment="Right" Padding="0"/>
                </Grid>
            </Border>

            <!-- 状态 + 视图切换 -->
            <Grid Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="TabText" Style="{StaticResource TabChip}" Content="文本"
                                 Foreground="White" FontSize="12.5" IsChecked="True" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabMd" Style="{StaticResource TabChip}" Content="Markdown"
                                 Foreground="White" FontSize="12.5" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabTable" Style="{StaticResource TabChip}" Content="表格"
                                 Foreground="White" FontSize="12.5" Checked="Tab_Changed"/>
                </StackPanel>
            </Grid>

            <!-- 文本视图 -->
            <Border x:Name="ViewText" Background="{DynamicResource InputBrush}" CornerRadius="8" Margin="16,10,16,0" Height="300">
                <TextBox x:Name="ResultBox"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" FontSize="14" Padding="10"/>
            </Border>

            <!-- Markdown 视图 -->
            <Border x:Name="ViewMd" Background="{DynamicResource InputBrush}" CornerRadius="8" Margin="16,10,16,0" Height="300" Visibility="Collapsed">
                <TextBox x:Name="MdBox"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" FontSize="13" Padding="10"/>
            </Border>

            <!-- 表格视图 -->
            <Border x:Name="ViewTable" Background="{DynamicResource InputBrush}" CornerRadius="8" Margin="16,10,16,0" Height="300" Visibility="Collapsed">
                <DataGrid x:Name="TableGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="Transparent"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          FontSize="13">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,18">
                <Button Content="搜索此文本" Style="{StaticResource SecondaryButtonStyle}" Width="102" Click="Search_Click"/>
                <Button Content="复制纯文本" Style="{StaticResource SecondaryButtonStyle}" Width="102" Margin="8,0,0,0" Click="CopyText_Click"/>
                <Button Content="复制 Markdown" Style="{StaticResource SecondaryButtonStyle}" Width="118" Margin="8,0,0,0" Click="CopyMd_Click"/>
                <Button Content="复制到 Excel" Style="{StaticResource SecondaryButtonStyle}" Width="106" Margin="8,0,0,0" Click="CopyTsv_Click"/>
                <Button Content="复制并关闭" Style="{StaticResource PrimaryButtonStyle}" Width="106" Margin="8,0,0,0" Click="CopyClose_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
