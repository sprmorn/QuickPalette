<Window x:Class="QuickPalette.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:QuickPalette.App.Behaviors"
        behaviors:MouseWheelScrollBehavior.Enabled="True"
        Title="轻启"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="900"
        Height="500"
        MinHeight="300"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 结果列表项样式 -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 窄滚动条样式：Track.Value/Minimum/Maximum/ViewportSize 与 ScrollBar 正确绑定（TwoWay），
             拇指可拖动、PageUp/PageDown 命令可翻页；ScrollViewer 走平台默认模板（其 Value ↔ VerticalOffset 由平台保证） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <!-- 垂直滚动条方向：顶部=最小值（IsDirectionReversed=True） -->
                            <Track IsDirectionReversed="True"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#55FFFFFF"
                                                        CornerRadius="3"
                                                        Margin="1,2,1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1"
            Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 搜索框（与背景融为一体，无边框无底色） -->
            <Border Grid.Row="0"
                    Margin="4,20,4,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 放大镜图标 -->
                    <Path Grid.Column="0"
                          Width="24" Height="24"
                          Margin="10,0,6,0"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Fill="{DynamicResource IconBrush}"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>

                    <!-- 搜索提示文字 -->
                    <TextBlock x:Name="SearchWatermark"
                               Grid.Column="1"
                               Text="搜索应用…"
                               Foreground="{DynamicResource TextHint}"
                               FontSize="22"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- 输入框 -->
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimary}"
                             FontSize="22"
                             Padding="0,14"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- 结果区域：结果列表 + 空态引导 -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ResultsList"
                         Margin="4,0,4,8"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ResultsList_SelectionChanged"
                         KeyDown="ResultsList_KeyDown"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         MouseRightButtonUp="ResultsList_MouseRightButtonUp"
                         MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                         ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                         ItemContainerStyle="{StaticResource ResultItemStyle}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <!-- 分组标题："应用 N" / "文件 M" -->
                                    <TextBlock Margin="10,10,8,2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDim}">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="28" Height="28"
                                       Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- 名称（命中高亮）/ 别名、类型标签和路径 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 名称按查询串切分为高亮分段 -->
                                        <ItemsControl ItemsSource="{Binding NameSegments}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontSize" Value="14"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text=" ★"
                                                   Foreground="#FFD700"
                                                   FontSize="12"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <!-- 类型标签：应用 / 文档 / 图片 ... -->
                                        <Border CornerRadius="3"
                                                Padding="5,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource FileTagBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="App">
                                                            <Setter Property="Background" Value="{DynamicResource AppTagBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Foreground="{DynamicResource FileTagTextBrush}"
                                                       FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SecondaryText}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ModifiedText}"
                                                   Foreground="{DynamicResource TextDim}"
                                                   FontSize="11"
                                                   Margin="8,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 快捷键/匹配提示 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding LaunchHint}"
                                           Foreground="{DynamicResource TextDim}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态引导提示 -->
                <TextBlock x:Name="EmptyHint"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextHint}"
                           FontSize="13"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 底部提示栏（动态显示当前可用快捷键） -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgBottomBar}"
                    CornerRadius="0,0,12,12"
                    Padding="16,8">
                <TextBlock x:Name="HintsText"
                           Foreground="{DynamicResource TextDim}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
