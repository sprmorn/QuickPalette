<Window x:Class="QuickPalette.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:QuickPalette.App.Behaviors"
        xmlns:local="clr-namespace:QuickPalette.App"
        Title="预览"
        WindowStyle="None"
        Background="{DynamicResource BgWindow}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Deactivated="Window_Deactivated"
        behaviors:MouseWheelScrollBehavior.Enabled="True"
        Width="440" Height="520">

    <!-- 圆角 + 阴影由 WindowChrome/DWM 提供。
         注意：这里不能用 AllowsTransparency 分层窗口——分层窗口不合成子 HWND 的内容，
         系统预览处理器（跨进程挂载的 Win32 窗口）会显示为空白（实测确认）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <!-- 与主面板同款视觉语言：圆角卡片 + 描边 + 主题资源 -->
    <Border CornerRadius="12"
            Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：文件名 + 类型标签 + 关闭（关闭按钮先声明固定 32×32，右上角） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,10">
                <DockPanel>
                    <Button x:Name="CloseButton"
                            Content="×"
                            DockPanel.Dock="Right"
                            Width="32" Height="32"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource HintBrush}"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"
                            Click="Close_Click"
                            Padding="0"/>

                    <Border DockPanel.Dock="Right"
                            CornerRadius="3"
                            Padding="5,1"
                            Margin="8,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource FileTagBrush}">
                        <TextBlock x:Name="TypeTagText"
                                   Foreground="{DynamicResource FileTagTextBrush}"
                                   FontSize="10"/>
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- 内容区：系统预览处理器槽位（Handler 模式，独立宿主进程挂载）
                 / 文本模式（只读可选中）/ 图像模式（PDF 逐页渲染、图片预览） -->
            <Grid Grid.Row="1">
                <Border x:Name="HandlerHostBorder" Visibility="Collapsed">
                    <local:PreviewSlotHost x:Name="SlotHost"/>
                </Border>

                <TextBox x:Name="ContentBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="14,10"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"/>

                <ScrollViewer x:Name="ImageScroll"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ImagePanel" Margin="10,8"/>
                </ScrollViewer>

                <TextBlock x:Name="LoadingText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDim}"
                           FontSize="13"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 底部提示栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgBottomBar}"
                    CornerRadius="0,0,12,12"
                    Padding="16,8">
                <TextBlock x:Name="HintText"
                           Foreground="{DynamicResource TextDim}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
