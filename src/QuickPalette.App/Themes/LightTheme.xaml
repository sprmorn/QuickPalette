<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 -->

    <!-- 窗口 / 背景 -->
    <SolidColorBrush x:Key="BgWindow" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="BgWindowBorder" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="BgTitle" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardBorder" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="BgInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInputBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="BgHover" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="BgSelected" Color="#3264C8"/>
    <SolidColorBrush x:Key="BgSelectedHover" Color="#3C78DC"/>
    <SolidColorBrush x:Key="BgBottomBar" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="BgRowAlt" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BgHeader" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BgTabBorder" Color="#DDDDDD"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="TextHint" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextDim" Color="#777777"/>
    <SolidColorBrush x:Key="TextDim2" Color="#555555"/>

    <!-- 图标 / 强调 -->
    <SolidColorBrush x:Key="IconBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3264C8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3C78DC"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D5FC7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E05050"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#D64545"/>
    <SolidColorBrush x:Key="CloseButtonBrush" Color="#888888"/>

    <!-- 类型标签（应用 / 文件）：浅底上文字改深色，保证对比度 -->
    <SolidColorBrush x:Key="AppTagBrush" Color="#332F6FED"/>
    <SolidColorBrush x:Key="AppTagTextBrush" Color="#1F3D75"/>
    <SolidColorBrush x:Key="FileTagBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="FileTagTextBrush" Color="#444444"/>

    <!-- 统一对话框资源键（AddAppWindow / EditAppWindow / FirstRunWindow 等窗口使用） -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555"/>
    <SolidColorBrush x:Key="HintBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9E9E9"/>

</ResourceDictionary>
