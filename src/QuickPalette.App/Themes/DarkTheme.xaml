<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题（与默认界面一致） -->

    <!-- 窗口 / 背景 -->
    <SolidColorBrush x:Key="BgWindow" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="BgWindowBorder" Color="#404040"/>
    <SolidColorBrush x:Key="BgTitle" Color="#252525"/>
    <SolidColorBrush x:Key="BgCard" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="BgCardBorder" Color="#444444"/>
    <SolidColorBrush x:Key="BgInput" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="BgInputBorder" Color="#505050"/>
    <SolidColorBrush x:Key="BgHover" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="BgSelected" Color="#3264C8"/>
    <SolidColorBrush x:Key="BgSelectedHover" Color="#3C78DC"/>
    <SolidColorBrush x:Key="BgBottomBar" Color="#252525"/>
    <SolidColorBrush x:Key="BgRowAlt" Color="#353535"/>
    <SolidColorBrush x:Key="BgHeader" Color="#333333"/>
    <SolidColorBrush x:Key="BgTabBorder" Color="#444444"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
    <SolidColorBrush x:Key="TextHint" Color="#6F6F6F"/>
    <SolidColorBrush x:Key="TextDim" Color="#666666"/>
    <SolidColorBrush x:Key="TextDim2" Color="#AAAAAA"/>

    <!-- 图标 / 强调 -->
    <SolidColorBrush x:Key="IconBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3264C8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3C78DC"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#6EA8FE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C83232"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC3C3C"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="CloseButtonBrush" Color="#888888"/>

    <!-- 类型标签（应用 / 文件） -->
    <SolidColorBrush x:Key="AppTagBrush" Color="#4D6EA8FE"/>
    <SolidColorBrush x:Key="AppTagTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FileTagBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="FileTagTextBrush" Color="#C8FFFFFF"/>

    <!-- 统一对话框资源键（AddAppWindow / EditAppWindow / FirstRunWindow 等窗口使用） -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="HintBrush" Color="#6F6F6F"/>
    <SolidColorBrush x:Key="InputBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#505050"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#4A4A4A"/>

</ResourceDictionary>
