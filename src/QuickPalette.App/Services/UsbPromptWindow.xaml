<Window x:Class="QuickPalette.App.Services.UsbPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="U盘小助手"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- 主按钮样式（与其它窗口同款） -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F52B3446"
            CornerRadius="12"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="16">
        <StackPanel Width="300">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ContentControl x:Name="DriveIconHost" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="U盘小助手"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DriveText"
                               Foreground="#CCFFFFFF"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="HintText"
                       Text="可直接打开文件夹，或安全弹出后拔出设备。"
                       Foreground="#99FFFFFF"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EjectButton" Style="{StaticResource SecondaryButtonStyle}" Click="Eject_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="EjectIconHost" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="弹出" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="OpenIconHost" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
