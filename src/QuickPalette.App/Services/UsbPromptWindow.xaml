<Window x:Class="QuickPalette.App.Services.UsbPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="U盘小助手"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- 图标按钮样式 -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 主图标按钮样式 -->
        <Style x:Key="PrimaryIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F52B3446"
            CornerRadius="12"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="12">
        <StackPanel Width="296">

            <!-- 小标签（不抢戏） -->
            <TextBlock Text="U盘小助手"
                       Foreground="#88FFFFFF"
                       FontSize="10"
                       Margin="0,0,0,7"/>

            <!-- 主行：盘符图标 + 名称/容量 + 打开/弹出（纯图标） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="DriveIconHost"
                                Grid.Column="0"
                                VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="9,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DriveNameText"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CapacityText"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="OpenButton"
                        Grid.Column="2"
                        ToolTip="打开文件夹"
                        Style="{StaticResource PrimaryIconButtonStyle}"
                        Click="Open_Click">
                    <ContentControl x:Name="OpenIconHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <Button x:Name="EjectButton"
                        Grid.Column="3"
                        Margin="7,0,0,0"
                        ToolTip="弹出"
                        Style="{StaticResource IconButtonStyle}"
                        Click="Eject_Click">
                    <ContentControl x:Name="EjectIconHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 容量条：全长=总容量，填充=已用（蓝条） -->
            <Grid Height="5" Margin="0,10,0,0">
                <Border x:Name="UsageTrack"
                        Background="#2EFFFFFF"
                        CornerRadius="2.5"
                        Height="5"/>
                <Border x:Name="UsageBar"
                        HorizontalAlignment="Left"
                        Background="#FF4C8DFF"
                        CornerRadius="2.5"
                        Height="5"
                        Width="0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
