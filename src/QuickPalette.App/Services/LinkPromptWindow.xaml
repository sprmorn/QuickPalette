<Window x:Class="QuickPalette.App.Services.LinkPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="链接助手"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F52B3446"
            CornerRadius="12"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="12">
        <StackPanel Width="300">

            <!-- 小标签（不抢戏） -->
            <TextBlock Text="链接助手"
                       Foreground="#88FFFFFF"
                       FontSize="10"
                       Margin="0,0,0,7"/>

            <!-- 主行：类目图标 + 目标应用/链接 + 打开/忽略 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="CategoryIconHost"
                                Grid.Column="0"
                                VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Margin="9,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="AppText"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UrlText"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="OpenButton"
                        Grid.Column="2"
                        ToolTip="打开"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Open_Click">
                    <ContentControl x:Name="OpenIconHost" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
                </Button>

                <Button x:Name="IgnoreButton"
                        Grid.Column="3"
                        Margin="7,0,0,0"
                        ToolTip="忽略"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Ignore_Click">
                    <ContentControl x:Name="IgnoreIconHost" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
