<Window x:Class="QuickPalette.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:QuickPalette.App.Behaviors"
        behaviors:MouseWheelScrollBehavior.Enabled="True"
        xmlns:local="clr-namespace:QuickPalette.App"
        Title="轻启 - 设置"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Width="750"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 危险按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 左侧导航项样式（Win11/DevToys 风格：圆角药丸 + 选中高亮） -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl：无页签条模板（页切换由左侧导航驱动，WPF 原生做法） -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab 样式 -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource BgWindow}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim2}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource BgTabBorder}"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 样式 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource BgCard}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgRowAlt}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgHeader}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim2}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BgTabBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RadioButton 样式 -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- CheckBox 样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 滑块样式（MaxResults） -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动移动窗口） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgTitle}"
                    CornerRadius="12,12,0,0"
                    Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 标题齿轮图标（随标题文字着色） -->
                        <Viewbox Width="19" Height="19" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="48" Height="48">
                                <Path Stroke="{Binding Foreground, ElementName=TitleText}" StrokeThickness="4" StrokeLineJoin="Round" Stretch="None"
                                      Data="M18.2838 43.1713C14.9327 42.1736 11.9498 40.3213 9.58787 37.867C10.469 36.8227 11 35.4734 11 34.0001C11 30.6864 8.31371 28.0001 5 28.0001C4.79955 28.0001 4.60139 28.01 4.40599 28.0292C4.13979 26.7277 4 25.3803 4 24.0001C4 21.9095 4.32077 19.8938 4.91579 17.9995C4.94381 17.9999 4.97188 18.0001 5 18.0001C8.31371 18.0001 11 15.3138 11 12.0001C11 11.0488 10.7786 10.1493 10.3846 9.35011C12.6975 7.1995 15.5205 5.59002 18.6521 4.72314C19.6444 6.66819 21.6667 8.00013 24 8.00013C26.3333 8.00013 28.3556 6.66819 29.3479 4.72314C32.4795 5.59002 35.3025 7.1995 37.6154 9.35011C37.2214 10.1493 37 11.0488 37 12.0001C37 15.3138 39.6863 18.0001 43 18.0001C43.0281 18.0001 43.0562 17.9999 43.0842 17.9995C43.6792 19.8938 44 21.9095 44 24.0001C44 25.3803 43.8602 26.7277 43.594 28.0292C43.3986 28.01 43.2005 28.0001 43 28.0001C39.6863 28.0001 37 30.6864 37 34.0001C37 35.4734 37.531 36.8227 38.4121 37.867C36.0502 40.3213 33.0673 42.1736 29.7162 43.1713C28.9428 40.752 26.676 39.0001 24 39.0001C21.324 39.0001 19.0572 40.752 18.2838 43.1713Z"/>
                                <Path Stroke="{Binding Foreground, ElementName=TitleText}" StrokeThickness="4" StrokeLineJoin="Round" Stretch="None"
                                      Data="M24 31C27.866 31 31 27.866 31 24C31 20.134 27.866 17 24 17C20.134 17 17 20.134 17 24C17 27.866 20.134 31 24 31Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TitleText"
                                   Text="设置"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Content="×"
                            Background="Transparent"
                            Foreground="{DynamicResource CloseButtonBrush}"
                            BorderThickness="0"
                            FontSize="16"
                            Width="28"
                            Height="28"
                            Cursor="Hand"
                            Click="Close_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="0"/>
                </Grid>
            </Border>

            <!-- 内容区域：左侧分类导航 + 右侧页内容（WPF 原生 ListBox/TabControl 双栏） -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：分类导航 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgCard}"
                        Padding="10,12,6,10">
                    <ListBox x:Name="NavList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem x:Name="NavApps">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavAppsIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAppsText" Text="应用管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavHotkey">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavHotkeyIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavHotkeyText" Text="快捷键" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavScreenshot">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavScreenshotIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavScreenshotText" Text="截图" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavToolbox">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavToolboxIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavToolboxText" Text="工具箱" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavGeneral">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavGeneralIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavGeneralText" Text="通用" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavFilters">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavFiltersIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavFiltersText" Text="过滤规则" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavBackup">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavBackupIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavBackupText" Text="备份" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavAbout">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="NavAboutIcon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAboutText" Text="关于" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource BgTabBorder}"/>

                <!-- 右：页内容（原 TabControl，页签条隐藏，由左侧导航驱动） -->
                <TabControl x:Name="MainTabs"
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0">

                <!-- 应用管理 Tab -->
                <TabItem x:Name="TabAppsItem" Header="📋 应用管理">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索/操作栏 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="AddAppButton"
                                    Content="添加应用"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddApp_Click"
                                    DockPanel.Dock="Right"/>

                            <Button x:Name="ImportAppsButton"
                                    Content="批量导入"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ImportApps_Click"
                                    DockPanel.Dock="Right"
                                    Margin="0,0,8,0"/>

                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource InputStyle}"
                                     TextChanged="SearchBox_TextChanged"
                                     Margin="0,0,10,0"/>
                        </DockPanel>

                        <!-- 应用列表 -->
                        <DataGrid x:Name="AppsDataGrid"
                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="2*"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80"/>
                                <DataGridTextColumn Header="启动次数" Binding="{Binding LaunchCount}" Width="80"/>
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="编辑"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource AccentTextBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="EditApp_Click"
                                                        Padding="5,2"
                                                        FontSize="12"/>
                                                <Button Content="删除"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource DangerTextBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="DeleteApp_Click"
                                                        Padding="5,2"
                                                        FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 状态栏 -->
                        <TextBlock x:Name="StatusText"
                                   Grid.Row="2"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>

                <!-- 快捷键设置 Tab -->
                <TabItem x:Name="TabHotkeyItem" Header="⌨ 快捷键">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock x:Name="HotkeySectionTitle"
                                       Text="全局快捷键设置"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,20"/>

                            <!-- 热键录制控件（录制 / 冲突探测 / 恢复默认） -->
                            <local:HotkeyRecorderControl x:Name="HotkeyRecorder"
                                                         Margin="0,0,0,15"/>

                            <!-- 快捷键说明 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="HotkeyUsageTitle"
                                               Text="使用说明"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>

                                    <TextBlock x:Name="HotkeyTriggerHint"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="13"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Foreground="{DynamicResource TextDim2}" FontSize="13" Margin="0,0,0,8">
                                        <Run FontWeight="Bold">Enter</Run> - 启动选中的应用
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource TextDim2}" FontSize="13" Margin="0,0,0,8">
                                        <Run FontWeight="Bold">Shift+Enter</Run> - 以管理员身份启动
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource TextDim2}" FontSize="13" Margin="0,0,0,8">
                                        <Run FontWeight="Bold">Ctrl+Enter</Run> - 打开应用所在目录
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource TextDim2}" FontSize="13" Margin="0,0,0,8">
                                        <Run FontWeight="Bold">Esc</Run> - 隐藏面板
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource TextDim2}" FontSize="13">
                                        <Run FontWeight="Bold">↑↓</Run> - 选择应用
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 截图设置 Tab -->
                <TabItem x:Name="TabScreenshotItem" Header="📷 截图">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock x:Name="ScreenshotSectionTitle"
                                       Text="截图"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,20"/>

                            <!-- 快捷键 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="ScreenshotHotkeyTitle"
                                               Text="截图快捷键"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>
                                    <local:HotkeyRecorderControl x:Name="ScreenshotHotkeyRecorder"
                                                                 Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ScreenshotHotkeyHint"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 行为与标注默认值 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="ScreenshotBehaviorTitle"
                                               Text="行为"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ScreenshotSmartCheckBox"
                                              Content="智能框选窗口（悬停高亮候选，单击选中）"
                                              Margin="0,0,0,12"/>

                                    <TextBlock x:Name="ScreenshotDefaultToolTitle"
                                               Text="默认标注工具"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ScreenshotToolBox" Margin="0,0,0,12"/>

                                    <TextBlock x:Name="ScreenshotColorFormatTitle"
                                               Text="取色器格式"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ScreenshotFormatBox" Margin="0,0,0,12"/>

                                    <TextBlock x:Name="ScreenshotMosaicTitle"
                                               Text="马赛克粒度"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <Slider x:Name="ScreenshotMosaicSlider"
                                            Minimum="4"
                                            Maximum="48"
                                            TickFrequency="2"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>

                            <!-- 输出 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock x:Name="ScreenshotOutputTitle"
                                               Text="输出"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ScreenshotSaveDirTitle"
                                               Text="保存目录"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button x:Name="ScreenshotBrowseButton"
                                                Content="浏览…"
                                                Click="ScreenshotBrowse_Click"
                                                DockPanel.Dock="Right"
                                                Padding="10,4"/>
                                        <TextBox x:Name="ScreenshotSaveDirBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ScreenshotSaveDirHint"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <TextBlock x:Name="ScreenshotTemplateTitle"
                                               Text="文件命名模板"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="13"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="ScreenshotTemplateBox"
                                             Style="{StaticResource InputStyle}"
                                             Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ScreenshotTemplateHint"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 通用设置 Tab -->
                <TabItem x:Name="TabToolboxItem" Header="🧰 工具箱">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- 置顶窗口 -->
                        <Border Background="{DynamicResource BgCard}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="置顶窗口"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="按快捷键把当前窗口置顶在最上层，再按一次取消置顶。"
                                           Foreground="{DynamicResource TextDim2}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <CheckBox x:Name="TopmostToolCheckBox"
                                          Content="启用置顶窗口"
                                          Margin="0,0,0,10"/>
                                <local:HotkeyRecorderControl x:Name="TopmostHotkeyRecorder"
                                                             Margin="0,0,0,6"/>
                                <TextBlock Text="提示：也可在目标窗口上使用，默认快捷键 Alt+F。"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 小助手（U盘小助手 + 链接助手） -->
                        <Border Background="{DynamicResource BgCard}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <!-- U盘小助手 -->
                                <TextBlock Text="U盘小助手"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="插入 U盘后弹出快捷操作：打开文件夹 / 安全弹出。"
                                           Foreground="{DynamicResource TextDim2}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <CheckBox x:Name="UsbAssistantCheckBox"
                                          Content="启用 U盘小助手"
                                          Margin="0,0,0,10"/>
                                <Button x:Name="UsbCheckNowButton"
                                        Content="立即检测已插入的 U盘"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="UsbCheckNow_Click"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"/>
                                <TextBlock Text="提示：提示窗右下角弹出，20 秒无操作自动关闭；'弹出'为系统安全弹出。"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <Separator Margin="0,14" Background="{DynamicResource BgTabBorder}"/>

                                <!-- 链接助手 -->
                                <TextBlock Text="链接助手"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="复制链接时右上角提示跳转：打开对应软件（网盘转存 / 下载 / 远程 / 入会 / 播放 / 浏览器）。"
                                           Foreground="{DynamicResource TextDim2}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <CheckBox x:Name="LinkAssistantCheckBox"
                                          Content="启用链接助手"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="提示分类"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="LinkCatMeetingCheckBox" Content="会议办公" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatRemoteCheckBox" Content="远程" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatCloudCheckBox" Content="网盘" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatDownloadCheckBox" Content="下载" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatMediaCheckBox" Content="影音" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatWebCheckBox" Content="网页" Margin="0,0,14,6"/>
                                    <CheckBox x:Name="LinkCatOtherCheckBox" Content="其他" Margin="0,0,0,6"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="重复提醒间隔"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="LinkDedupBox" Width="110" VerticalAlignment="Center">
                                        <ComboBoxItem Content="5 分钟" Tag="5"/>
                                        <ComboBoxItem Content="10 分钟" Tag="10"/>
                                        <ComboBoxItem Content="30 分钟" Tag="30"/>
                                        <ComboBoxItem Content="不限" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="提示：没复制东西不会弹；同一链接按间隔去重（网页链接同域名 5 分钟只弹一次）；目标软件未安装时不提示。"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 网络搜索 -->
                        <Border Background="{DynamicResource BgCard}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock x:Name="DeepSeekTitle"
                                           Text="网络搜索"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>

                                <TextBlock x:Name="DeepSeekDesc"
                                           Text="在搜索框输入「指令 关键词」回车直接搜索，或输入指令后按 Tab 进入搜索模式。指令：bd 百度 · dy 抖音 · bl 哔哩哔哩 · ds DeepSeek。"
                                           Foreground="{DynamicResource TextDim2}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <CheckBox x:Name="DeepSeekCheckBox"
                                          Content="启用网络搜索（bd / dy / bl / ds）"/>

                                <TextBlock x:Name="DeepSeekHint"
                                           Text="提示：DeepSeek 搜索需登录 DeepSeek 账号；其余指令直接打开对应网站搜索。"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabGeneralItem" Header="⚙ 通用">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock x:Name="GeneralTitle"
                                       Text="通用设置"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,20"/>

                            <!-- 外观设置 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="AppearanceTitle"
                                               Text="外观"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>

                                    <RadioButton x:Name="ThemeLight"
                                                 Content="浅色模式"
                                                 GroupName="Theme"
                                                 Checked="ThemeRadio_Checked"
                                                 Margin="0,0,0,8"/>
                                    <RadioButton x:Name="ThemeDark"
                                                 Content="深色模式"
                                                 GroupName="Theme"
                                                 Checked="ThemeRadio_Checked"
                                                 Margin="0,0,0,8"/>
                                    <RadioButton x:Name="ThemeSystem"
                                                 Content="跟随系统"
                                                 GroupName="Theme"
                                                 Checked="ThemeRadio_Checked"/>

                                    <TextBlock x:Name="ThemeHintText"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 启动行为 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="StartupTitle"
                                               Text="启动行为"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>

                                    <CheckBox x:Name="AutoStartCheckBox"
                                              Content="开机自动启动"/>
                                </StackPanel>
                            </Border>

                            <!-- 结果条数 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="MaxResultsTitle"
                                               Text="最大结果条数"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>

                                    <Slider x:Name="MaxResultsSlider"
                                            Minimum="5"
                                            Maximum="20"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="MaxResultsSlider_ValueChanged"/>

                                    <TextBlock x:Name="MaxResultsHint"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 文档预览 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="PreviewTitle"
                                               Text="文档预览"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,5"/>

                                    <TextBlock x:Name="PreviewDesc"
                                               Text="单击文档结果时在面板旁弹出预览窗口（支持 PDF/Word/Excel/PPT/Markdown/TXT）。"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <CheckBox x:Name="PreviewCheckBox"
                                              Content="单击文档时显示预览窗口"/>
                                </StackPanel>
                            </Border>

                            <!-- 本地文件搜索 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="FileSearchTitle"
                                               Text="本地文件搜索"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,5"/>

                                    <TextBlock x:Name="FileSearchDesc"
                                               Text="基于 NTFS USN 日志的全盘文件名索引（Everything 同款机制），搜索应用时同时匹配本地文件。"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <CheckBox x:Name="FileSearchCheckBox"
                                              Content="启用本地文件搜索（首次启用需授予管理员权限建立索引）"
                                              Margin="0,0,0,10"/>

                                    <TextBlock x:Name="FileSearchStatusText"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <Button x:Name="RebuildIndexButton"
                                            Content="立即重建索引"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RebuildIndex_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- 重置设置 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock x:Name="ResetTitle"
                                               Text="重置"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,10"/>

                                    <TextBlock x:Name="ResetDesc"
                                               Text="重置所有设置将恢复默认值，但不会删除已添加的应用。"
                                               Foreground="{DynamicResource TextDim2}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <Button x:Name="ResetButton"
                                            Content="重置所有设置"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="ResetSettings_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 过滤规则 Tab -->
                <TabItem x:Name="TabFiltersItem" Header="🔍 过滤规则">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock x:Name="FiltersTitle"
                                       Text="过滤规则"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="FiltersDesc"
                                       Text="名称/路径命中黑名单的候选不会出现在扫描结果中；白名单中的条目永不过滤。"
                                       Foreground="{DynamicResource TextDim2}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="FilterSystemComponentsCheckBox"
                                      Content="过滤系统组件（设置、反馈中心等明显系统项）"
                                      Margin="0,0,0,12"/>

                            <!-- 名称关键词黑名单 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="FilterKeywordsTitle"
                                               Text="名称关键词黑名单"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,8"/>

                                    <ListBox x:Name="KeywordsList"
                                             Height="110"
                                             Background="{DynamicResource BgInput}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BgInputBorder}"
                                             Margin="0,0,0,8"/>

                                    <DockPanel>
                                        <Button x:Name="KeywordsAddButton"
                                                Content="添加"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="KeywordsAdd_Click"
                                                Margin="8,0,0,0"/>
                                        <Button x:Name="KeywordsRemoveButton"
                                                Content="删除所选"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="KeywordsRemove_Click"/>
                                        <TextBox x:Name="KeywordsInput"
                                                 Style="{StaticResource InputStyle}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 路径黑名单 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="FilterPathsTitle"
                                               Text="路径黑名单"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,8"/>

                                    <ListBox x:Name="PathsList"
                                             Height="110"
                                             Background="{DynamicResource BgInput}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BgInputBorder}"
                                             Margin="0,0,0,8"/>

                                    <DockPanel>
                                        <Button x:Name="PathsAddButton"
                                                Content="添加"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PathsAdd_Click"
                                                Margin="8,0,0,0"/>
                                        <Button x:Name="PathsRemoveButton"
                                                Content="删除所选"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PathsRemove_Click"/>
                                        <TextBox x:Name="PathsInput"
                                                 Style="{StaticResource InputStyle}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 白名单 -->
                            <Border Background="{DynamicResource BgCard}"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="WhitelistTitle"
                                               Text="白名单（永不过滤）"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Margin="0,0,0,8"/>

                                    <ListBox x:Name="WhitelistItems"
                                             Height="110"
                                             Background="{DynamicResource BgInput}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BgInputBorder}"
                                             Margin="0,0,0,8"/>

                                    <DockPanel>
                                        <Button x:Name="WhitelistAddButton"
                                                Content="添加"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="WhitelistAdd_Click"
                                                Margin="8,0,0,0"/>
                                        <Button x:Name="WhitelistRemoveButton"
                                                Content="删除所选"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="WhitelistRemove_Click"/>
                                        <TextBox x:Name="WhitelistInput"
                                                 Style="{StaticResource InputStyle}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 备份 Tab -->
                <TabItem x:Name="TabBackupItem" Header="💾 备份">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="BackupTitle"
                                   Text="备份与恢复"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="BackupDesc"
                                   Text="导出为单一 quickpalette-backup.json，可在重装或换机后一键恢复。"
                                   Foreground="{DynamicResource TextDim2}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="BackupNowButton"
                                    Content="立即备份"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BackupNow_Click"
                                    Margin="0,0,10,10"/>

                            <Button x:Name="ExportBackupButton"
                                    Content="导出备份…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportBackup_Click"
                                    Margin="0,0,10,10"/>

                            <Button x:Name="ImportBackupButton"
                                    Content="导入备份…"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ImportBackup_Click"
                                    Margin="0,0,10,10"/>

                            <Button x:Name="RestoreLatestButton"
                                    Content="从最近备份恢复"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RestoreLatest_Click"
                                    Margin="0,0,10,10"/>

                            <Button x:Name="OpenDataDirButton"
                                    Content="打开数据目录"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenDataDir_Click"
                                    Margin="0,0,10,10"/>
                        </WrapPanel>

                        <TextBlock x:Name="BackupStatusText"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabAboutItem" Header="🎀 关于">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" HorizontalAlignment="Center">
                            <Image x:Name="AboutImage"
                                   Source="Assets/about.png"
                                   MaxWidth="260"
                                   Margin="0,20,0,16"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <TextBlock Text="春晨制品"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="AboutProductName"
                                       Text="轻启 QuickPalette · 轻量 Windows 快捷启动器"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="AboutVersionText"
                                       Text="版本 1.7.0"
                                       Foreground="{DynamicResource TextDim2}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDim2}"
                                       FontSize="12">
                                <Hyperlink x:Name="AboutGithubLink"
                                           Click="AboutGithub_Click"
                                           Foreground="{DynamicResource AccentTextBrush}">
                                    https://github.com/sprmorn/QuickPalette
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock Text="感谢每一位使用者 ❤"
                                       Foreground="{DynamicResource TextDim2}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,24"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,10,20,20">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>

                <Button x:Name="SaveButton"
                        Content="保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
