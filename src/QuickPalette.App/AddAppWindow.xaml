<Window x:Class="QuickPalette.App.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:QuickPalette.App.Behaviors"
        behaviors:MouseWheelScrollBehavior.Enabled="True"
        Title="添加应用"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="500"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 输入框样式（随主题资源） -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 类型下拉框 -->
        <Style x:Key="TypeComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="16,12">
                <DockPanel>
                    <!-- 关闭按钮必须先声明（Dock=Right 先停靠）：DockPanel 会把最后一个子元素拉伸填满剩余空间 -->
                    <Button x:Name="CloseButton"
                            Content="×"
                            DockPanel.Dock="Right"
                            Width="32" Height="32"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            Foreground="{DynamicResource HintBrush}"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"
                            Click="Close_Click"
                            Padding="0"/>

                    <TextBlock x:Name="TitleText"
                               Text="添加应用"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="16"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 表单内容 -->
            <ScrollViewer Grid.Row="1"
                          Margin="20,15"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 名称 -->
                    <TextBlock x:Name="NameLabel"
                               Text="名称 *"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,12"/>

                    <!-- 路径 -->
                    <TextBlock x:Name="PathLabel"
                               Text="路径 *"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button x:Name="BrowseButton"
                                Content="浏览…"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Browse_Click"
                                Margin="8,0,0,0"
                                Padding="12,6"/>
                        <TextBox x:Name="PathBox"
                                 Style="{StaticResource InputStyle}"
                                 AllowDrop="True"
                                 Drop="PathBox_Drop"
                                 DragOver="PathBox_DragOver"/>
                    </DockPanel>
                    <TextBlock x:Name="PathHint"
                               Text="拖拽 .exe / .lnk / .url / .cmd / .bat 文件到上方输入框"
                               Foreground="{DynamicResource HintBrush}"
                               FontSize="11"
                               Margin="0,0,0,12"/>

                    <!-- 应用类型 -->
                    <TextBlock x:Name="TypeLabel"
                               Text="应用类型"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="TypeBox"
                              Style="{StaticResource TypeComboStyle}"
                              Margin="0,0,0,12"/>

                    <!-- 参数 -->
                    <TextBlock x:Name="ArgsLabel"
                               Text="启动参数"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="ArgsBox"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,12"/>

                    <!-- 工作目录 -->
                    <TextBlock x:Name="WorkDirLabel"
                               Text="工作目录"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="WorkDirBox"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,12"/>

                    <!-- 别名 -->
                    <TextBlock x:Name="AliasesLabel"
                               Text="别名（逗号分隔）"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="AliasesBox"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,10"/>

                    <!-- 管理员运行 -->
                    <CheckBox x:Name="AdminCheckBox"
                              Content="以管理员身份运行"
                              Foreground="{DynamicResource TextBrush}"
                              Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,10,20,20">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="80"
                        Height="32"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <Button x:Name="AddButton"
                        Content="添加"
                        Width="80"
                        Height="32"
                        Click="Add_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
