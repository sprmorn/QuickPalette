<Window x:Class="QuickPalette.App.Recorder.RecordingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录屏 · 编辑"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BgWindowBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel Width="640">
            <!-- 标题栏（可拖动） -->
            <Border Background="{DynamicResource BgTitle}" CornerRadius="12,12,0,0" Padding="16,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl x:Name="TitleIconHost" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="录屏 · 编辑"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Background="Transparent"
                            Foreground="{DynamicResource CloseButtonBrush}" BorderThickness="0"
                            FontSize="16" Width="28" Height="28" Cursor="Hand" Click="Close_Click"
                            HorizontalAlignment="Right" Padding="0"/>
                </Grid>
            </Border>

            <!-- 预览 -->
            <Border Background="#11000000" Margin="16,14,16,0" CornerRadius="8" Height="330">
                <MediaElement x:Name="Preview" Stretch="Uniform" LoadedBehavior="Manual"
                              UnloadedBehavior="Stop" ScrubbingEnabled="True"/>
            </Border>

            <!-- 播放控制 -->
            <Grid Margin="16,10,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Content="▶" Width="38" Height="30"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Play_Click"/>
                <TextBlock x:Name="TimeText" Grid.Column="1" Text="00:00 / 00:00"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0"/>
                <ContentControl x:Name="SpeedIconHost" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SpeedBox" Grid.Column="3" Width="92" VerticalAlignment="Center"
                          SelectionChanged="Speed_Changed">
                    <ComboBoxItem Content="0.5×" Tag="0.5"/>
                    <ComboBoxItem Content="1×" Tag="1" IsSelected="True"/>
                    <ComboBoxItem Content="1.5×" Tag="1.5"/>
                    <ComboBoxItem Content="2×" Tag="2"/>
                </ComboBox>
            </Grid>

            <!-- 裁剪 -->
            <StackPanel Margin="16,12,16,0">
                <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="CropIconHost" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TrimText" Text="裁剪：0.0s – 全部"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Slider x:Name="TrimStartSlider" Minimum="0" Maximum="1" Margin="0,8,0,0"
                        ValueChanged="Trim_Changed"/>
                <Slider x:Name="TrimEndSlider" Minimum="0" Maximum="1" Value="1" Margin="0,2,0,0"
                        ValueChanged="Trim_Changed"/>
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,16,16,18">
                <Button Content="复制" Style="{StaticResource SecondaryButtonStyle}" Width="92" Click="Copy_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Width="92" Margin="10,0,0,0" Click="Save_Click"/>
                <Button Content="另存为…" Style="{StaticResource SecondaryButtonStyle}" Width="92" Margin="10,0,0,0" Click="SaveAs_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
