<Window x:Class="QuickPalette.App.Recorder.RecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制中"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- 图标按钮 -->
        <Style x:Key="BarIconButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarStopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFE5484D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFCF3B40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F52B3446"
            CornerRadius="10"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="10,8">
        <StackPanel Orientation="Horizontal">
            <!-- 计时 -->
            <Border Background="#2EFFFFFF" CornerRadius="6" Padding="10,0" Height="32"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#FFE5484D" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TimerText"
                               Text="00:00"
                               Foreground="White"
                               FontSize="14"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Width="1" Background="#44FFFFFF" Margin="9,6"/>

            <!-- 音频开关 -->
            <ToggleButton x:Name="MicButton" Style="{StaticResource BarIconButtonStyle}"
                          ToolTip="麦克风" Margin="0,0,6,0" Checked="Mic_Toggled" Unchecked="Mic_Toggled">
                <ContentControl x:Name="MicIconHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ToggleButton>
            <ToggleButton x:Name="VolumeButton" Style="{StaticResource BarIconButtonStyle}"
                          ToolTip="系统声音" Margin="0,0,6,0" Checked="Volume_Toggled" Unchecked="Volume_Toggled">
                <ContentControl x:Name="VolumeIconHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ToggleButton>

            <Border Width="1" Background="#44FFFFFF" Margin="3,6"/>

            <!-- 暂停/继续 -->
            <ToggleButton x:Name="PauseButton" Style="{StaticResource BarIconButtonStyle}"
                          ToolTip="暂停/继续" Margin="0,0,6,0" Checked="Pause_Toggled" Unchecked="Pause_Toggled">
                <ContentControl x:Name="PauseIconHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ToggleButton>

            <!-- 停止 -->
            <Button x:Name="StopButton" Style="{StaticResource BarStopButtonStyle}"
                    ToolTip="停止录制" Click="Stop_Click">
                <ContentControl x:Name="StopIconHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
